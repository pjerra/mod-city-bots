#
# mod-city-bots configuration
#

CitizenBots.Enable = 1

# Logging:
# - LogLevel 0 = errors only, 1 = warnings/errors, 2 = info/warnings/errors,
#   3 = debug/info/warnings/errors.
# - LogMirrorToModule = 0 logs only through the playerbots category. Set to 1
#   only if you intentionally want the same city-bot lines mirrored to the
#   module category too.
CitizenBots.LogLevel = 2
CitizenBots.LogMirrorToModule = 0

# V2 stage-cast mode:
# - 0% means "do not convert random leveling bots into city bots".
# - Dedicated accounts are the fixed 400-character cast seeded by SQL
#   (GUIDs 9000001-9000400, accounts citybot12001-citybot12400).
# - Normal Playerbot.MinRandomBots/MaxRandomBots log in first. City bots log in
#   afterward, on top of that normal population.
# - Set worldserver PlayerLimit to at least MaxRandomBots + 400 (e.g. 1600 for
#   1200 random bots + full stage-cast population).
# - Stage-cast accounts must use playerbots account_type 3 (see SQL update
#   2026_07_16_12). Do NOT mark them type 2 (AddClass) or playerbots will load
#   all 400 into the addclass cache and hammer acore_characters at startup.
# - With one CharacterDatabase async worker (default), city logins wait for the
#   queue to drain after random autologin. Increase CharacterDatabase.WorkerThreads
#   in worldserver.conf if stage cast still stalls under heavy random-bot load.
CitizenBots.Percent = 0
CitizenBots.UseDedicatedAccounts = 1

# Online defaults with the values below:
# - Always-on population: 400 city bots.
# - Hybrid burst mode can be re-enabled below for a lower always-on baseline.
# - All 400 roster GUIDs are assigned below, including 30 Dalaran citizens.

# Hybrid population: set to 1 for a low always-on baseline that bursts to max
# when a real player enters a regional hub. The default 0 keeps all configured
# city bots online all the time.
CitizenBots.HybridPopulation = 1
CitizenBots.CountRealPlayers = 1
CitizenBots.BurstGraceSec = 180

# --- Alliance capitals (CityCount = default target; CityCount.Min = hybrid baseline) ---
CitizenBots.CityCount.Stormwind = 76
CitizenBots.CityCount.Min.Stormwind = 8
CitizenBots.CityCount.Ironforge = 25
CitizenBots.CityCount.Min.Ironforge = 3
CitizenBots.CityCount.Darnassus = 20
CitizenBots.CityCount.Min.Darnassus = 2
CitizenBots.CityCount.Exodar = 10
CitizenBots.CityCount.Min.Exodar = 2

# --- Horde capitals ---
CitizenBots.CityCount.Orgrimmar = 75
CitizenBots.CityCount.Min.Orgrimmar = 8
CitizenBots.CityCount.Undercity = 25
CitizenBots.CityCount.Min.Undercity = 3
CitizenBots.CityCount.ThunderBluff = 20
CitizenBots.CityCount.Min.ThunderBluff = 2
CitizenBots.CityCount.Silvermoon = 20
CitizenBots.CityCount.Min.Silvermoon = 2

# --- Fixed neutral hubs ---
CitizenBots.CityCount.Shattrath = 20
CitizenBots.CityCount.Dalaran = 30

# --- Goldshire + gate duel hubs (gates always 22 dedicated duelists each) ---
CitizenBots.CityCount.Goldshire = 35
CitizenBots.CityCount.Min.Goldshire = 8
CitizenBots.CityCount.StormwindGate = 22
CitizenBots.CityCount.OrgrimmarGate = 22

# Goldshire fixed roles are seeded in citizen_roster: 2 inn dancers, 2 duelers,
# 4 plaza talkers. The remaining 27 Goldshire citizens are flex ambience.
CitizenBots.Goldshire.MinInnDancers = 2
CitizenBots.Goldshire.MinDuelers = 2
CitizenBots.Goldshire.PlazaTalkers = 4

# --- Explicit stage-cast assignment sheet ---
#
# These lists decide what each dedicated citybot GUID does. The database still
# owns character identity, but these settings override home, role, POI rotation,
# login priority, and whether the bot is static or burst-only.
#
# Static lists are always part of the city stage cast. *Burst lists only log in
# when the existing hybrid population target for that location rises.
# Duelers are intentionally static-only; do not put duelers in burst lists.
#
# Set CitizenBots.Assign.RequireListed = 0 to keep unlisted roster rows as their
# database-defined fallback assignment. With the default 1, an unlisted citybot
# does not log in.
CitizenBots.Assign.RequireListed = 1

CitizenBots.Assign.StormwindGate.Duelers = 9000001,9000002,9000003,9000004,9000005,9000006,9000007,9000008,9000009,9000010,9000011,9000012,9000351,9000352,9000353,9000354,9000355,9000356,9000357,9000358,9000359,9000360
