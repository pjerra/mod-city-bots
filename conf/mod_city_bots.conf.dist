# Shorter activity windows make the stage feel alive without letting permanent
# cast members wander away from their assigned city/POI.
CitizenBots.ActivityDurationMinSec = 45
CitizenBots.ActivityDurationMaxSec = 180

CitizenBots.RandomSayChance = 0

# Keep city bots out of /say by default. Playerbot chat replies can cascade
# hard when many staged bots hear each other, so emotes/dances/duels carry
# the ambiance unless this is explicitly enabled.
CitizenBots.EnableSay = 1
CitizenBots.SayCooldownSec = 30
CitizenBots.EnableFishing = 1
CitizenBots.EnableLogoutCycle = 0
CitizenBots.TeleportIfOutsideCity = 1
CitizenBots.KeepEmoteStrategy = 1
CitizenBots.KeepFoodStrategy = 1

# Living-crowd scenes (bank/AH squares; see docs/specs/2026-08-11-living-crowd-design.md)
CitizenBots.EnableCrowdScenes = 1
CitizenBots.CrowdPlayerRadius = 60
CitizenBots.CrowdChatCooldownSec = 90
CitizenBots.CrowdAfkMinSec = 60
CitizenBots.CrowdAfkMaxSec = 180

# Chance for non-dueler city bots to mount while traveling between outdoor POIs.
# Bots dismount again when they arrive so emotes/fishing/social actions look normal.
CitizenBots.MountBetweenPoiChance = 90

CitizenBots.Weight.WanderDistrict = 30
CitizenBots.Weight.SitInTavern = 20
CitizenBots.Weight.RandomEmote = 15
CitizenBots.Weight.VisitAuctionHouse = 10
CitizenBots.Weight.VisitMailbox = 10
CitizenBots.Weight.BuyFood = 10
CitizenBots.Weight.VisitTrainer = 8
CitizenBots.Weight.WatchDuels = 12
CitizenBots.Weight.DrinkInTavern = 10
CitizenBots.Weight.WalkCityWalls = 10
CitizenBots.Weight.FishAtDocks = 5
CitizenBots.Weight.ReturnToInn = 15
CitizenBots.Weight.Logout = 3

# Legacy fallback only. With CityCount.* configured above, this is ignored.
# Leave at 0 for the V2 fixed-roster profile.
CitizenBots.DedicatedCount = 0
